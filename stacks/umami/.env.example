# Umami analytics
BIND_ADDRESS=127.0.0.1
UMAMI_PORT=3002

POSTGRES_DB=umami
POSTGRES_USER=umami
# Used inside DATABASE_URL, so keep it URL-safe (hex is).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate: openssl rand -hex 32
APP_SECRET=

# Rename the tracker file to avoid ad blockers, e.g. "stats.js"
TRACKER_SCRIPT_NAME=script.js
