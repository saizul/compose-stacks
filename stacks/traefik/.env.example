# Traefik reverse proxy
# E-mail for Let's Encrypt expiry notices (required)
ACME_EMAIL=
# Use the staging CA while testing to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Ports 80 and 443 must be public for certificates and visitors.
PUBLIC_BIND_ADDRESS=0.0.0.0
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080

# Shared Docker network other stacks join to be routed by Traefik.
TRAEFIK_NETWORK=proxy
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESS_LOG=false

# Demo: set COMPOSE_PROFILES=demo and point WHOAMI_HOST's DNS at this server.
COMPOSE_PROFILES=
WHOAMI_HOST=whoami.example.com
