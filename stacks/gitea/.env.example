# Gitea + PostgreSQL
BIND_ADDRESS=127.0.0.1
GITEA_HTTP_PORT=3000
# Git over SSH must be reachable from outside: 0.0.0.0 by default.
SSH_BIND_ADDRESS=0.0.0.0
GITEA_SSH_PORT=2222

GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/
# The first user who registers in the installer becomes admin; keep sign-up closed after that.
GITEA_DISABLE_REGISTRATION=true

POSTGRES_DB=gitea
POSTGRES_USER=gitea
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
