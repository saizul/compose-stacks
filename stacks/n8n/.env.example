# n8n + PostgreSQL (optional Redis queue mode)
# `compose-stacks init n8n` copies this file to .env and fills the secrets.

BIND_ADDRESS=127.0.0.1
N8N_PORT=5678

# Public address. Behind HTTPS set N8N_PROTOCOL=https, N8N_SECURE_COOKIE=true
# and WEBHOOK_URL=https://n8n.example.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=1
TZ=UTC

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts stored credentials. Back it up: without it saved credentials are lost.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Queue mode: set EXECUTIONS_MODE=queue and COMPOSE_PROFILES=queue
EXECUTIONS_MODE=regular
COMPOSE_PROFILES=
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=false
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Keep execution history for this many hours (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=336
