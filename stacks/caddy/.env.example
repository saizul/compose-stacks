# Caddy
# Domain served by Caddy. "localhost" gives a locally trusted certificate for testing.
SITE_DOMAIN=localhost
# Where requests go. host.docker.internal is the Docker host, so apps from other
# stacks published on 127.0.0.1 are reachable (on Linux they must listen on the
# docker0 bridge or on 0.0.0.0; joining a shared network is the cleaner option).
UPSTREAM=host.docker.internal:8080
# E-mail for certificate expiry notices (optional but recommended)
ACME_EMAIL=
PUBLIC_BIND_ADDRESS=0.0.0.0
