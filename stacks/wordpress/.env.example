# WordPress + MariaDB + Redis
# `compose-stacks init wordpress` copies this file to .env and fills the secrets.

# Interface for the published port. Keep 127.0.0.1 behind a reverse proxy
# (see the traefik or caddy stacks); use 0.0.0.0 only for quick local tests.
BIND_ADDRESS=127.0.0.1
WORDPRESS_PORT=8080

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_TABLE_PREFIX=wp_

# Generate: openssl rand -hex 24
WORDPRESS_DB_PASSWORD=
# Generate: openssl rand -hex 24
MARIADB_ROOT_PASSWORD=
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# Memory cap for the object cache.
REDIS_MAXMEMORY=256mb
