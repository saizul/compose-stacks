# Ollama + Open WebUI
BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3080
WEBUI_URL=http://localhost:3080

# Signs login sessions. Changing it logs everyone out.
# Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=

# The first account becomes admin. New accounts wait for approval ("pending").
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending

# How long a model stays in memory after a request
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
