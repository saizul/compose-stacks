# Vaultwarden
BIND_ADDRESS=127.0.0.1
VAULTWARDEN_PORT=8222

# Full public HTTPS URL of the vault
VAULTWARDEN_DOMAIN=https://vault.example.com

# Create your account(s), then set SIGNUPS_ALLOWED=false and recreate the container.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true

# Enables the /admin page. Leave empty to disable it. For production replace the
# value with an Argon2 PHC hash: docker compose exec vaultwarden /vaultwarden hash
# Generate: openssl rand -base64 48
ADMIN_TOKEN=

LOG_LEVEL=warn
TZ=UTC
