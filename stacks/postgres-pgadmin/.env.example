# PostgreSQL + pgAdmin
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
PGADMIN_PORT=5050

POSTGRES_DB=app
# servers.json pre-registers the server for this user name.
POSTGRES_USER=postgres
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# pgAdmin login
PGADMIN_EMAIL=admin@example.com
# Generate: openssl rand -base64 24
PGADMIN_PASSWORD=
